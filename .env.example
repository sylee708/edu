# ─────────────────────────────────────────────────────────────
# 공공데이터포털 - 나라장터 입찰공고정보서비스 인증키
# ─────────────────────────────────────────────────────────────
# 포털 마이페이지에서 "Encoding" 키를 그대로 붙여넣으세요.
# (%2B, %2F 같은 문자가 들어있는 형태 → 코드가 자동으로 인식합니다)
# Decoding 키를 넣어도 동작하도록 처리되어 있습니다.
G2B_SERVICE_KEY=

# API 베이스 URL (기본값 사용 권장. 구버전 경로가 필요하면 아래 주석 값으로 교체)
# G2B_BASE_URL=https://apis.data.go.kr/1230000/BidPublicInfoService
G2B_BASE_URL=https://apis.data.go.kr/1230000/ad/BidPublicInfoService

# ─────────────────────────────────────────────────────────────
# 텔레그램 (나중에 채워도 됩니다. 아래 두 채널이 모두 비어 있으면 '모의 발송' 모드로 동작)
# ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────────────────────────
# 슬랙 (텔레그램 대신, 또는 함께 써도 됩니다. Incoming Webhook URL 하나면 충분합니다)
# https://api.slack.com/messaging/webhooks
# ─────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=

# ─────────────────────────────────────────────────────────────
# Neon 데이터베이스 (나중에 채워도 됩니다. 비어 있으면 로컬 .data/store.json 사용)
# ─────────────────────────────────────────────────────────────
DATABASE_URL=

# ─────────────────────────────────────────────────────────────
# Vercel Cron 보호용 시크릿 (배포 시 임의 문자열 지정)
# ─────────────────────────────────────────────────────────────
CRON_SECRET=
